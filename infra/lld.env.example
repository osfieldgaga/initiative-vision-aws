# /etc/lld.env for infra/lld.service (sudo install -m 600 infra/lld.env.example /etc/lld.env, then edit)
LLD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/lld-frames.fifo
# shared with the website (Vercel env var of the same name); generate with: openssl rand -hex 32
LIVE_TOKEN_SECRET=
# stop the instance after this many minutes without frames or viewers (0 = never)
LLD_IDLE_STOP_MIN=20
LLD_MAX_LAG_S=2
